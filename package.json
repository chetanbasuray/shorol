{
  "name": "shorol",
  "version": "0.0.0-development",
  "description": "Fluent, human-readable regex builder for JavaScript/TypeScript.",
  "type": "module",
  "license": "MIT",
  "author": "Chetan Basuray",
  "homepage": "https://github.com/chetanbasuray/shorol",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chetanbasuray/shorol.git"
  },
  "bugs": {
    "url": "https://github.com/chetanbasuray/shorol/issues"
  },
  "keywords": [
    "regex",
    "regexp",
    "regex-builder",
    "fluent",
    "builder",
    "typescript",
    "javascript",
    "validation",
    "pattern-matching",
    "ai",
    "readability"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./presets": {
      "import": {
        "types": "./dist/presets.d.ts",
        "default": "./dist/presets.js"
      },
      "require": {
        "types": "./dist/presets.d.cts",
        "default": "./dist/presets.cjs"
      }
    },
    "./llms.txt": "./docs/llms.txt",
    "./SKILL.md": "./docs/SKILL.md"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "docs:sync": "doc-sync-check src --include docs/api-signatures.md --strict",
    "format": "prettier --write .",
    "commitlint": "commitlint --from=origin/main --to=HEAD",
    "prepare": "node ./scripts/prepare-husky.mjs",
    "prepack": "npm run build",
    "release": "semantic-release"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.11",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitest/coverage-v8": "^5.1.1",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "doc-sync-check": "^1.9.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.3",
    "husky": "^9.0.11",
    "prettier": "^3.10.1",
    "semantic-release": "^25.0.9",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
